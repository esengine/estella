#!/bin/sh
# Pre-push: the one gate a push itself decides. Every user-facing commit must reach a release note
# (tools/releaseNotes.mjs) or say why it cannot, and a commit that does not turns master's CI red for
# everyone after it. The check reads only git history, well under a second; the rest of the gates stay in CI.
if [ ! -f desktop/package.json ]; then
  echo 'pre-push: changelog-covers skipped — no editor checkout at desktop/, whose commits it also reads.'
  exit 0
fi
if ! node tools/check-changelog-covers.mjs; then
  echo ''
  echo '✗ push blocked: a user-facing commit reaches no release note.'
  echo '  Add the key it printed to tools/releaseNotes.mjs — { note: <a CHANGELOG headline> } or { internal: <why no creator can see it> } —'
  echo '  with a CHANGELOG.md entry when the note is new, commit that, and push again.'
  exit 1
fi
