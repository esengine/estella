{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "esengine": ["./.esengine/sdk/index.d.ts"],
      "estella-plugin-*": ["./.esengine/packages/*"],
      "esengine/wasm": ["./.esengine/sdk/wasm.d.ts"],
      "esengine/ai": ["./.esengine/sdk/ai/index.d.ts"],
      "esengine/tilemap": ["./.esengine/sdk/tilemap/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
