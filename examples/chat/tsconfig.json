{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "esengine": ["./.esengine/sdk/index.d.ts"],
      "esengine/spine": ["./.esengine/sdk/spine/index.d.ts"],
      "esengine/tilemap": ["./.esengine/sdk/tilemap/index.d.ts"],
      "esengine/terrain": ["./.esengine/sdk/terrain/index.d.ts"],
      "esengine/timeline": ["./.esengine/sdk/timeline/index.d.ts"],
      "esengine/fx-basic": ["./.esengine/sdk/fx-basic/index.d.ts"],
      "esengine/fx-atmosphere": ["./.esengine/sdk/fx-atmosphere/index.d.ts"],
      "esengine/fx-lighting": ["./.esengine/sdk/fx-lighting/index.d.ts"],
      "esengine/fx-agx": ["./.esengine/sdk/fx-agx/index.d.ts"],
      "esengine/foliage": ["./.esengine/sdk/foliage/index.d.ts"],
      "esengine/worldgen": ["./.esengine/sdk/worldgen/index.d.ts"],
      "esengine/water": ["./.esengine/sdk/water/index.d.ts"],
      "esengine/spline": ["./.esengine/sdk/spline/index.d.ts"],
      "esengine/image": ["./.esengine/sdk/image/index.d.ts"],
      "esengine/sound": ["./.esengine/sdk/sound/index.d.ts"],
      "esengine/voxel": ["./.esengine/sdk/voxel/index.d.ts"],
      "esengine/rig2d": ["./.esengine/sdk/rig2d/index.d.ts"],
      "esengine/imported-scene": ["./.esengine/sdk/imported-scene/index.d.ts"],
      "esengine/skeletal-animation": ["./.esengine/sdk/skeletal-animation/index.d.ts"],
      "esengine/character-shaders": ["./.esengine/sdk/character-shaders/index.d.ts"],
      "esengine/logic": ["./.esengine/sdk/logic/index.d.ts"],
      "esengine/debug-channel": ["./.esengine/sdk/debug-channel/index.d.ts"],
      "esengine/ai": ["./.esengine/sdk/ai/index.d.ts"],
      "esengine/replication": ["./.esengine/sdk/net/replication/index.d.ts"],
      "esengine/session": ["./.esengine/sdk/net/session/index.d.ts"],
      "esengine/gameplay": ["./.esengine/sdk/gameplay/index.d.ts"],
      "esengine/dragonbones": ["./.esengine/sdk/dragonbones/index.d.ts"],
      "esengine/physics": ["./.esengine/sdk/physics/index.d.ts"],
      "esengine/physics3d": ["./.esengine/sdk/physics3d/index.d.ts"],
      "esengine/douyin": ["./.esengine/sdk/douyin/index.d.ts"],
      "esengine/kuaishou": ["./.esengine/sdk/kuaishou/index.d.ts"],
      "esengine/bilibili": ["./.esengine/sdk/bilibili/index.d.ts"],
      "esengine/quickgame": ["./.esengine/sdk/quickgame/index.d.ts"],
      "esengine/alipay": ["./.esengine/sdk/alipay/index.d.ts"],
      "esengine/huawei": ["./.esengine/sdk/huawei/index.d.ts"],
      "esengine/openpaas": ["./.esengine/sdk/openpaas/index.d.ts"],
      "estella-plugin-*": ["./.esengine/packages/*"],
      "esengine/wasm": ["./.esengine/sdk/wasm.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
