    "profiles": {
      "prod-web": {
        "platform": "web",
        "config": "shipping",
        "remoteRoot": "https://cdn.example.com/hot-update-demo"
      },
      "prod-android": {
        "platform": "android",
        "config": "shipping",
        "remoteRoot": "https://cdn.example.com/hot-update-demo"
      }
    }
  }
