#pragma shader "Lighting2D"
#pragma version 300 es
#pragma domain Lit2D

#pragma fragment
precision mediump float;

in vec4 v_color;
in vec2 v_texCoord;
in highp vec2 v_worldPos;

uniform sampler2D u_textures[8];

out vec4 fragColor;

// The LightConstants block + applyLighting2D() are injected by the engine for
// `#pragma domain Lit2D`; the vertex stage is engine-injected too. These surfaces
// carry no texture, so u_textures[0] is the default 1×1 white — the sprite's
// `color` is the albedo the lights multiply. A flat normal faces the camera.
void main() {
    vec4 base = texture(u_textures[0], v_texCoord) * v_color;
    vec3 N = vec3(0.0, 0.0, 1.0);
    vec3 lit = applyLighting2D(base.rgb, N, v_worldPos);
    fragColor = vec4(lit, base.a);
}
#pragma end
