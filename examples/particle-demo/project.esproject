{
  "formatVersion": "1",
  "name": "Particle Effects",
  "description": "A gallery of particle effects — page through Campfire, Fireworks, Magic Portal, Fountain, Snowfall and Sparkles with on-screen buttons, and click to throw fireworks.",
  "tag": "Effects",
  "version": "0.2.0",
  "defaultScene": "assets/scenes/main.esscene",
  "designResolution": {
    "width": 1280,
    "height": 720
  },
  "spineVersion": "none",
  "packaging": {
    "platform": "playable",
    "config": "shipping",
    "sourceMaps": true,
    "openFolder": true,
    "outDir": {
      "playable": "dist-playable"
    },
    "compressTextures": true,
    "atlasTextures": true
  }
}
