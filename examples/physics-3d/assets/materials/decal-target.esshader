#pragma shader "DecalTarget"
#pragma version 300 es
#pragma domain Lit
#pragma param u_tint color default(1,0.32,0.12,1)

#pragma fragment
precision mediump float;

in vec4 v_color;
in vec2 v_texCoord;

out vec4 fragColor;

void main() {
    // A target: the SHAPE is what says the decal took the projector's
    // coordinates, which a solid patch of colour would not.
    vec2 d = v_texCoord - vec2(0.5);
    float r = length(d) * 2.0;
    float ring = step(0.62, r) * step(r, 0.86);
    float bar = max(step(abs(d.x), 0.035), step(abs(d.y), 0.035)) * step(r, 0.95);
    if (max(ring, bar) < 0.5) discard;
    fragColor = vec4(u_tint.rgb, 1.0);
}
#pragma end
