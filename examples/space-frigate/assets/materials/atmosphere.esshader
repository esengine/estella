#pragma shader "Space Atmosphere"
#pragma version 300 es
#pragma domain Unlit
#pragma param u_rim color default(0.4,0.62,1,1)
#pragma param u_power float default(3) range(0.5,12)
#pragma param u_strength float default(2) range(0,20)
#pragma param u_sun vec3 default(0,1,0)

#pragma fragment
precision highp float;

in vec4 v_color;
in vec2 v_texCoord;
#ifdef MESH_NORMALS
in highp vec3 v_worldNormal;
in highp vec3 v_worldXYZ;
#endif

out vec4 fragColor;

void main() {
#ifdef MESH_NORMALS
    vec3 N = normalize(v_worldNormal);
    float facing = clamp(dot(N, viewDirection(v_worldXYZ)), 0.0, 1.0);
    float rim = pow(1.0 - facing, u_power) * smoothstep(0.0, 0.22, facing);
    float day = smoothstep(-0.3, 0.45, dot(N, normalize(u_sun)));
    fragColor = vec4(u_rim.rgb * (rim * day * u_strength), 1.0);
#else
    fragColor = vec4(0.0, 0.0, 0.0, 1.0);
#endif
}
#pragma end
