#pragma shader "Gate Field"
#pragma version 300 es
#pragma domain Unlit
#pragma feature MESH_LOCAL_POSITION
#pragma param u_core color default(0.7,0.9,1,1)
#pragma param u_edge color default(0.08,0.3,1,1)
#pragma param u_strength float default(1.2) range(0,20)
#pragma param u_swirl float default(1) range(0,4)
#pragma param u_front float default(4) range(0,4)
#pragma param u_burst float default(0) range(0,20)

#pragma fragment
precision highp float;

in vec4 v_color;
in vec2 v_texCoord;
#ifdef MESH_LOCAL_POSITION
in highp vec3 v_localPos;
#endif

out vec4 fragColor;

float cell(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float cloud(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(cell(i), cell(i + vec2(1.0, 0.0)), u.x), mix(cell(i + vec2(0.0, 1.0)), cell(i + vec2(1.0, 1.0)), u.x), u.y);
}

void main() {
    vec2 p = v_texCoord * 2.0 - 1.0;
#ifdef MESH_LOCAL_POSITION
    p = v_localPos.xy;
#endif
    float r = length(p);
    float t = u_time.x;
    float turn = t * 0.12 + (1.0 - r) * 1.6 * u_swirl;
    vec2 q = mat2(cos(turn), -sin(turn), sin(turn), cos(turn)) * p;
    float drift = cloud(q * 5.0 + vec2(t * 0.07, 0.0)) * 0.6 + cloud(q * 11.0 - vec2(0.0, t * 0.11)) * 0.4;
    float waves = 0.5 + 0.5 * sin(r * 46.0 - t * 2.4 + drift * 5.0);
    float rim = smoothstep(0.5, 1.0, r);
    float inside = 1.0 - smoothstep(0.985, 1.0, r);
    float body = 0.05 + 0.3 * drift * drift + rim * rim * (0.35 + 0.45 * waves);
    vec3 tone = mix(u_core.rgb, u_edge.rgb, clamp(r * 0.8 + (1.0 - drift) * 0.3, 0.0, 1.0));
    float off = r - u_front;
    float crest = exp(-pow(off / 0.014, 2.0));
    float halo = exp(-pow(off / 0.07, 2.0));
    float wake = step(off, 0.0) * exp(off * 9.0) * (0.3 + 0.7 * drift);
    vec3 wave = (u_core.rgb * crest + u_edge.rgb * (halo * 0.5 + wake * 0.35)) * u_burst;
    fragColor = vec4((tone * (body * u_strength) + wave) * inside, 1.0);
}
#pragma end
