#pragma shader "Space Plume"
#pragma version 300 es
#pragma domain Unlit
#pragma feature MESH_LOCAL_POSITION
#pragma param u_core color default(0.75,0.9,1,1)
#pragma param u_edge color default(0.1,0.35,1,1)
#pragma param u_strength float default(6) range(0,60)
#pragma param u_length float default(11) range(0.1,100)
#pragma param u_flicker float default(0.15) range(0,1)

#pragma fragment
precision highp float;

in vec4 v_color;
in vec2 v_texCoord;
#ifdef MESH_NORMALS
in highp vec3 v_worldNormal;
in highp vec3 v_worldXYZ;
#endif
#ifdef MESH_LOCAL_POSITION
in highp vec3 v_localPos;
#endif

out vec4 fragColor;

void main() {
    float along = 0.0;
    float facing = 1.0;
#ifdef MESH_LOCAL_POSITION
    along = clamp(-v_localPos.z / u_length, 0.0, 1.0);
#endif
#ifdef MESH_NORMALS
    facing = abs(dot(normalize(v_worldNormal), viewDirection(v_worldXYZ)));
#endif
    float body = pow(facing, 1.6);
    float fade = pow(1.0 - along, 2.2);
    float pulse = 1.0 + u_flicker * sin(u_time.x * 37.0 + along * 26.0) * (0.4 + along);
    float shock = 0.75 + 0.25 * sin(along * 46.0 - u_time.x * 9.0);
    vec3 tone = mix(u_edge.rgb, u_core.rgb, body * (1.0 - along * 0.7));
    fragColor = vec4(tone * (body * fade * pulse * shock * u_strength), 1.0);
}
#pragma end
