#pragma shader "HUD Lens"
#pragma version 300 es
#pragma domain PostProcess
#pragma param u_curve float default(0.03) range(0,0.2)
#pragma param u_fringe float default(0.0016) range(0,0.05)
#pragma param u_scan float default(0.1) range(0,1)
#pragma param u_glow float default(0.22) range(0,2)

#pragma fragment
precision highp float;

in vec2 v_texCoord;
uniform sampler2D u_texture;
out vec4 fragColor;

vec2 bent(vec2 p, float k) {
    return p * (1.0 + k * (dot(p, p) - 1.0)) * 0.5 + 0.5;
}

void main() {
    vec2 p = v_texCoord * 2.0 - 1.0;
    vec2 at = bent(p, u_curve);
    vec4 mid = texture(u_texture, at);
    float red = texture(u_texture, bent(p, u_curve + u_fringe)).r;
    float blue = texture(u_texture, bent(p, u_curve - u_fringe)).b;
    vec3 halo = vec3(0.0);
    for (int i = 0; i < 8; i++) {
        float turn = float(i) * 0.7853982;
        halo += texture(u_texture, at + vec2(cos(turn), sin(turn)) * u_viewport.zw * 7.0).rgb;
    }
    vec4 layer = vec4(vec3(red, mid.g, blue) + halo * 0.125 * u_glow, mid.a);
    float line = 1.0 - u_scan * (0.5 + 0.5 * sin(gl_FragCoord.y * 2.0943951 + u_time.x * 6.0));
    fragColor = layer * line;
}
#pragma end

#pragma fragment wgsl
fn bent(p : vec2f, k : f32) -> vec2f {
    return p * (1.0 + k * (dot(p, p) - 1.0)) * 0.5 + 0.5;
}

@fragment fn fs_main(v : VSOut) -> @location(0) vec4f {
    let p = v.v_texCoord * 2.0 - 1.0;
    let at = bent(p, mc.u_curve);
    let mid = textureSampleLevel(t0, s0, at, 0.0);
    let red = textureSampleLevel(t0, s0, bent(p, mc.u_curve + mc.u_fringe), 0.0).r;
    let blue = textureSampleLevel(t0, s0, bent(p, mc.u_curve - mc.u_fringe), 0.0).b;
    var halo = vec3f(0.0);
    for (var i = 0; i < 8; i++) {
        let turn = f32(i) * 0.7853982;
        halo += textureSampleLevel(t0, s0, at + vec2f(cos(turn), sin(turn)) * tc.u_viewport.zw * 7.0, 0.0).rgb;
    }
    let layer = vec4f(vec3f(red, mid.g, blue) + halo * 0.125 * mc.u_glow, mid.a);
    let line = 1.0 - mc.u_scan * (0.5 + 0.5 * sin(v.pos.y * 2.0943951 + tc.u_time.x * 6.0));
    return layer * line;
}
#pragma end
