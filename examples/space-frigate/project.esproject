{
  "formatVersion": "1",
  "name": "Space Frigate",
  "description": "A frigate on patrol off a gas giant, built from a recipe: its hull, plating, worn paint, windows and engines are steps in a model source, and the nebula, planet and stars are generated.",
  "tag": "3D",
  "version": "0.1.0",
  "defaultScene": "assets/scenes/main.esscene",
  "designResolution": { "width": 1600, "height": 900 },
  "spineVersion": "none",
  "scripts": { "main": "src/main.ts" },
  "assetExclude": ["tools"],
  "features": { "rendering": { "colorSpace": "linear", "outputTransform": "aces", "quality": { "mode": "high" } } }
}
