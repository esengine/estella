{
  "parameters": [
    { "name": "Speed", "type": "float" },
    { "name": "Jump", "type": "trigger" }
  ],
  "states": [
    { "name": "Idle", "x": 120, "y": 130, "clip": "assets/animations/idle.esanim", "loop": true, "transitions": [ { "to": "Run", "conditions": [ { "param": "Speed", "op": "gt", "value": 0.1 } ] } ] },
    { "name": "Run", "x": 380, "y": 130, "clip": "assets/animations/walk.esanim", "loop": true, "transitions": [ { "to": "Idle", "conditions": [ { "param": "Speed", "op": "lt", "value": 0.1 } ] } ] },
    { "name": "Jump", "x": 250, "y": 320, "transitions": [ { "to": "Idle", "hasExitTime": true, "conditions": [] } ] }
  ],
  "initialState": "Idle",
  "anyStateTransitions": [ { "to": "Jump", "conditions": [ { "param": "Jump", "op": "trigger" } ] } ]
}
