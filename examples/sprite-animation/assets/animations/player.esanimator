{
  "parameters": [
    { "name": "speed", "type": "float", "default": 0 },
    { "name": "hop", "type": "trigger" }
  ],
  "initialState": "Idle",
  "states": [
    {
      "name": "Idle",
      "x": 140,
      "y": 140,
      "clip": "assets/animations/idle.esanim",
      "loop": true,
      "transitions": [
        { "to": "Move", "conditions": [ { "param": "speed", "op": "gt", "value": 20 } ] },
        { "to": "Hop", "conditions": [ { "param": "hop", "op": "trigger" } ] }
      ]
    },
    {
      "name": "Move",
      "x": 420,
      "y": 140,
      "blend": {
        "parameter": "speed",
        "thresholds": [
          { "value": 0, "clip": "assets/animations/walk.esanim", "speed": 1.0 },
          { "value": 150, "clip": "assets/animations/walk.esanim", "speed": 1.9 }
        ]
      },
      "transitions": [
        { "to": "Idle", "conditions": [ { "param": "speed", "op": "lt", "value": 15 } ] },
        { "to": "Hop", "conditions": [ { "param": "hop", "op": "trigger" } ] }
      ]
    },
    {
      "name": "Hop",
      "x": 280,
      "y": 340,
      "clip": "hop",
      "loop": false,
      "transitions": [
        { "to": "Idle", "hasExitTime": true, "conditions": [] }
      ]
    }
  ]
}
