#pragma shader "Starfall temple illumination"
#pragma version 300 es
#pragma domain Unlit
#pragma param u_clock float default(0)
#pragma param u_light vec4 default(-220,-78,0,0)
#pragma param u_gate float default(0.2)

#pragma fragment
precision highp float;
in vec4 v_color;
in vec2 v_texCoord;
uniform sampler2D u_textures[8];
out vec4 fragColor;
void main() {
    vec4 base = texture(u_textures[0], v_texCoord) * v_color;
    vec2 p = vec2(v_texCoord.x*1280.-640.,v_texCoord.y*720.-360.);
    vec2 d = (p - u_light.xy) / vec2(205., 145.);
    float lamp = exp(-dot(d,d)*1.8) * u_light.z;
    vec2 floorD = (p - vec2(u_light.x,-135.)) / vec2(235.,26.);
    float bounce = exp(-dot(floorD,floorD)) * u_light.z;
    vec2 gate = (p - vec2(89.,116.)) / 190.;
    float halo = exp(-dot(gate,gate)*1.35) * u_gate;
    float sky = smoothstep(10.,250.,p.y);
    float veil = pow(max(0.,sin(p.x*.006 + p.y*.009 + u_clock*.3)),4.) * sky;
    float mist = exp(-pow((p.y+108.+sin(p.x*.007+u_clock*.24)*10.)/28.,2.));
    vec3 light = vec3(.12,.68,.61)*(lamp+halo*.35) + vec3(.1,.47,.4)*bounce;
    vec3 color = base.rgb * (1. + light*1.6) + light*.13;
    color += vec3(.025,.075,.09)*veil + vec3(.025,.05,.065)*mist*(.6+.4*sin(p.x*.008-u_clock*.4));
    fragColor = vec4(color,base.a);
}
#pragma end

#pragma fragment wgsl
@fragment fn fs_main(v:VSOut)->@location(0) vec4f {
    let base = textureSample(t0,s0,v.v_texCoord) * v.v_color;
    let p = vec2f(v.v_texCoord.x*1280.-640.,v.v_texCoord.y*720.-360.);
    let d = (p - mc.u_light.xy) / vec2f(205.,145.);
    let lamp = exp(-dot(d,d)*1.8) * mc.u_light.z;
    let floorD = (p - vec2f(mc.u_light.x,-135.)) / vec2f(235.,26.);
    let bounce = exp(-dot(floorD,floorD)) * mc.u_light.z;
    let gate = (p - vec2f(89.,116.)) / 190.;
    let halo = exp(-dot(gate,gate)*1.35) * mc.u_gate;
    let sky = smoothstep(10.,250.,p.y);
    let veil = pow(max(0.,sin(p.x*.006+p.y*.009+mc.u_clock*.3)),4.)*sky;
    let mist = exp(-pow((p.y+108.+sin(p.x*.007+mc.u_clock*.24)*10.)/28.,2.));
    let light = vec3f(.12,.68,.61)*(lamp+halo*.35) + vec3f(.1,.47,.4)*bounce;
    var color = base.rgb*(vec3f(1.)+light*1.6)+light*.13;
    color += vec3f(.025,.075,.09)*veil+vec3f(.025,.05,.065)*mist*(.6+.4*sin(p.x*.008-mc.u_clock*.4));
    return vec4f(color,base.a);
}
#pragma end
