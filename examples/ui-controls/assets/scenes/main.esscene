        {
          "type": "Text",
          "data": {
            "content": "A dialog is a backdrop plus a panel you fill with children — Escape and a click on the scrim both close it, with no code to hook up.\n\nThis panel is a ScrollView: drag it, or roll the wheel over it. The viewport clips with a UIMask and the frame behind it moves, which is what the UIScroll component on the viewport asks for.\n\nEvery control on the panel behind this one is authored the same way — dropped into the scene, wired by name.",
            "fontSize": 13,
            "color": {
              "r": 0.85,
              "g": 0.87,
              "b": 0.92,
              "a": 1
            },
            "align": 0,
            "verticalAlign": 0,
            "wordWrap": true
          }
        }
      ]
    },
