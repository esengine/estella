#pragma shader "Energy Core"
#pragma version 300 es
#pragma domain Unlit
#pragma param u_inner color default(0.35,0.85,1,1)
#pragma param u_rim color default(0.55,0.3,1,1)
#pragma param u_intensity float default(4) range(0,60)
#pragma param u_flow float default(1) range(0,8)
#pragma param u_instability float default(0) range(0,1) ui(slider)

#pragma fragment
precision highp float;

in vec4 v_color;
in vec2 v_texCoord;
#ifdef MESH_NORMALS
in highp vec3 v_worldNormal;
in highp vec3 v_worldXYZ;
#endif

uniform sampler2D u_textures[8];

out vec4 fragColor;

float coreHash(vec3 p) {
    p = fract(p * 0.3183099 + vec3(0.1, 0.2, 0.3));
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}
float coreNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(coreHash(i), coreHash(i + vec3(1, 0, 0)), f.x),
                   mix(coreHash(i + vec3(0, 1, 0)), coreHash(i + vec3(1, 1, 0)), f.x), f.y),
               mix(mix(coreHash(i + vec3(0, 0, 1)), coreHash(i + vec3(1, 0, 1)), f.x),
                   mix(coreHash(i + vec3(0, 1, 1)), coreHash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
float coreFbm(vec3 p) {
    float sum = 0.0;
    float amp = 0.5;
    for (int i = 0; i < 4; i++) {
        sum += coreNoise(p) * amp;
        p = p * 2.03 + vec3(7.1, 3.3, 5.7);
        amp *= 0.5;
    }
    return sum / 0.9375;
}

void main() {
#ifdef MESH_NORMALS
    vec3 N = normalize(v_worldNormal);
    float facing = abs(dot(N, viewDirection(v_worldXYZ)));
    vec3 at = N * 2.4;
#else
    float facing = clamp(1.0 - 2.0 * length(v_texCoord - 0.5), 0.0, 1.0);
    vec3 at = vec3(v_texCoord * 4.0, 0.0);
#endif
    float t = u_time.x * u_flow;
    float warp = coreFbm(at * 1.3 + vec3(0.0, t * 0.35, t * 0.2));
    float field = coreFbm(at * 2.2 + vec3(warp * 2.4, -t * 0.6, warp * 1.7 + t * 0.25));
    float veins = pow(1.0 - abs(field * 2.0 - 1.0), 14.0);
    float flicker = 1.0 + u_instability * (coreNoise(vec3(t * 9.0, 1.7, 4.2)) - 0.35) * 1.4;
    float rim = pow(1.0 - facing, 2.2);
    float heart = pow(facing, 3.0);
    vec3 colour = u_inner.rgb * (veins * 4.0 + heart * (0.05 + 0.5 * u_instability)) + u_rim.rgb * (rim * 1.6 + 0.12);
    colour = mix(colour, vec3(dot(colour, vec3(0.34))) + colour * 0.6, u_instability * heart);
    float alpha = clamp(rim + veins + heart * 0.35, 0.0, 1.0) * v_color.a;
    fragColor = vec4(colour * u_intensity * flicker * v_color.rgb, alpha);
}
#pragma end
