#pragma shader "Glow"
#pragma version 300 es
#pragma domain Unlit
#pragma param u_color color default(1,1,1,1)
#pragma param u_intensity float default(1) range(0,40)

#pragma fragment
precision highp float;

in vec4 v_color;
in vec2 v_texCoord;

uniform sampler2D u_textures[8];

out vec4 fragColor;

void main() {
    vec4 tex = texture(u_textures[0], v_texCoord);
    fragColor = vec4(tex.rgb * v_color.rgb * u_color.rgb * u_intensity, tex.a * v_color.a);
}
#pragma end
