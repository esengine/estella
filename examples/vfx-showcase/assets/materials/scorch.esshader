#pragma shader "Scorch"
#pragma version 300 es
#pragma domain Unlit
#pragma param u_heat float default(1) range(0,1) ui(slider)
#pragma param u_soot float default(1) range(0,1) ui(slider)

#pragma fragment
precision highp float;

in vec4 v_color;
in vec2 v_texCoord;

uniform sampler2D u_textures[8];

out vec4 fragColor;

vec2 scorchHash(vec2 p) {
    return fract(sin(vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)))) * 43758.5453123);
}
float scorchNoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(scorchHash(i).x, scorchHash(i + vec2(1.0, 0.0)).x, f.x),
               mix(scorchHash(i + vec2(0.0, 1.0)).x, scorchHash(i + vec2(1.0, 1.0)).x, f.x), f.y);
}
float cracks(vec2 p) {
    vec2 cell = floor(p);
    vec2 f = fract(p);
    float first = 8.0;
    float second = 8.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 o = vec2(float(x), float(y));
            float d = length(o + scorchHash(cell + o) - f);
            if (d < first) { second = first; first = d; }
            else if (d < second) { second = d; }
        }
    }
    return second - first;
}

void main() {
    vec2 p = (v_texCoord - 0.5) * 2.0;
    float r = length(p);
    float a = atan(p.y, p.x);
    float rays = scorchNoise(vec2(a * 5.0, 1.0)) * 0.5 + scorchNoise(vec2(a * 13.0, 7.0)) * 0.25;
    float reach = 0.55 + rays * 0.45;
    float body = 1.0 - smoothstep(reach * 0.55, reach, r);
    float grit = scorchNoise(p * 14.0) * 0.5 + scorchNoise(p * 37.0) * 0.5;
    float soot = clamp(body * (0.65 + grit * 0.5), 0.0, 1.0) * u_soot * 0.88;

    vec2 warped = p + (vec2(scorchNoise(p * 3.0), scorchNoise(p * 3.0 + 11.0)) - 0.5) * 0.25;
    float seam = cracks(warped * 5.5);
    float fine = cracks(warped * 13.0 + 4.0);
    float vein = (1.0 - smoothstep(0.0, 0.035, seam)) + 0.4 * (1.0 - smoothstep(0.0, 0.03, fine));
    float core = exp(-r * 9.0);
    float falloff = 1.0 - smoothstep(0.05, reach * 0.75, r);
    float temperature = clamp((vein * falloff + core * 1.4) * u_heat * (0.6 + 0.4 * u_heat), 0.0, 2.0);
    vec3 glow = vec3(1.0, 0.16, 0.02) * smoothstep(0.02, 0.5, temperature) * 3.0
              + vec3(1.0, 0.55, 0.12) * smoothstep(0.45, 1.0, temperature) * 7.0
              + vec3(1.0, 0.9, 0.7) * smoothstep(1.0, 1.8, temperature) * 14.0;
    vec3 ash = vec3(0.012, 0.011, 0.012);
    fragColor = vec4((ash * soot + glow) * v_color.rgb, soot) * v_color.a;
}
#pragma end
