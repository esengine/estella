{
  "formatVersion": "1",
  "name": "Video Playback",
  "description": "Play a video on a Sprite via the Video component.",
  "tag": "Rendering",
  "version": "0.1.0",
  "defaultScene": "assets/scenes/main.esscene",
  "designResolution": {
    "width": 640,
    "height": 480
  },
  "spineVersion": "none",
  "packaging": {
    "platform": "playable",
    "config": "shipping",
    "sourceMaps": false,
    "openFolder": true,
    "outDir": {
      "wechat": "dist-wechat",
      "playable": "dist-playable"
    },
    "compressTextures": false,
    "atlasTextures": false,
    "compressAudio": false
  }
}
