{
  "formatVersion": "1",
  "name": "Video Puzzle",
  "description": "A sliding-tile puzzle whose tiles are live regions of ONE playing video.",
  "tag": "Gameplay",
  "version": "0.1.0",
  "defaultScene": "assets/scenes/main.esscene",
  "designResolution": {
    "width": 640,
    "height": 480
  },
  "spineVersion": "none",
  "packaging": {
    "platform": "wechat",
    "config": "shipping",
    "sourceMaps": false,
    "openFolder": true,
    "outDir": {
      "wechat": "dist-wechat"
    },
    "compressTextures": false,
    "atlasTextures": false,
    "compressAudio": false
  }
}
