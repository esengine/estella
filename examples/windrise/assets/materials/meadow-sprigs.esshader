#pragma shader "Meadow blade clusters"
#pragma version 300 es
#pragma domain Unlit
#pragma param u_alphaCutoff float default(0.42) range(0,1)
#pragma coverage u_alphaCutoff
#pragma fragment
precision highp float;
in vec2 v_texCoord;
in vec4 v_color;
uniform sampler2D u_textures[1];
out vec4 fragColor;
void main(){
    vec4 blades=texture(u_textures[0],v_texCoord);
    if(blades.a<u_alphaCutoff) discard;
    float light=dot(blades.rgb,vec3(.22,.70,.08));
    vec3 green=mix(vec3(.126,.272,.055),vec3(.387,.564,.132),clamp(.19+light*.84+v_color.g*.21,0.,1.));
    fragColor=vec4(mix(vec3(.048,.115,.060),green,v_color.r),1.);
}
#pragma end

#pragma fragment wgsl
var<private> fragColor : vec4f;
@diagnostic(off, derivative_uniformity)
fn es_main() {
    let blades = textureSample(t0, s0, es_v.v_texCoord);
    if (blades.a < mc.u_alphaCutoff) {
        discard;
    }
    let light = dot(blades.rgb, vec3f(0.22, 0.70, 0.08));
    let green = mix(vec3f(0.126, 0.272, 0.055), vec3f(0.387, 0.564, 0.132), clamp((0.19 + (light * 0.84)) + (es_v.v_color.g * 0.21), 0.0, 1.0));
    fragColor = vec4f(mix(vec3f(0.048, 0.115, 0.060), green, es_v.v_color.r), 1.0);
}
var<private> es_v : VSOut;
@fragment fn fs_main(es_in : VSOut) -> @location(0) vec4f {
    es_v = es_in;
    es_main();
    return fragColor;
}
#pragma end
