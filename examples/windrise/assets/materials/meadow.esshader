#pragma shader "Windrise meadow"
#pragma version 300 es
#pragma domain Lit
#pragma param u_tint color default(1,1,1,1)

#pragma param u_shadeColor color default(0.55,0.5,0.7,1)

#pragma param u_bands float default(3) range(1,8) ui(slider)
#pragma param u_bandSoftness float default(0.03) range(0,0.5) ui(slider)

#pragma param u_specThreshold float default(0.6) range(0,1) ui(slider)
#pragma param u_specSoftness float default(0.02) range(0,0.5) ui(slider)
#pragma param u_specColor color default(1,1,1,1)
#pragma param u_specSize float default(0.35) range(0,1) ui(slider)

#pragma param u_rimColor color default(1,1,1,1)
#pragma param u_rimWidth float default(0.35) range(0,1) ui(slider)
#pragma param u_rimSoftness float default(0.05) range(0,0.5) ui(slider)
#pragma param u_rimStrength float default(0) range(0,1) ui(slider)
#pragma param u_occlusionMap texture default(white) texel(data)
#pragma param u_occlusionStrength float default(1) range(0,1) ui(slider)
#pragma param u_emissive color default(0,0,0,1)
#pragma param u_emissiveMap texture default(white)
#pragma param u_alphaCutoff float default(0) range(0,1) ui(slider)
#pragma coverage u_alphaCutoff

#pragma fragment
precision mediump float;

in vec4 v_color;
in vec2 v_texCoord;
in highp vec2 v_worldPos;
#ifdef MESH_NORMALS
in highp vec3 v_worldNormal;
in highp vec3 v_worldXYZ;
#endif

uniform sampler2D u_textures[1];

#ifdef ES_GBUFFER
layout(location = 0) out vec4 fragColor;
layout(location = 1) out vec4 fragSurface;

layout(location = 2) out vec4 fragAlbedo;
vec2 packNormal(vec3 n) {
n /= (abs(n.x) + abs(n.y) + abs(n.z));
vec2 sgn = vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * sgn;
return e * 0.5 + 0.5;
}
#else
out vec4 fragColor;
#endif


float toonBand(float level) {
float t = clamp(level, 0.0, 1.0) * u_bands;
float i = floor(t);
float f = t - i;
float soft = max(u_bandSoftness, 1e-4);
return min((i + smoothstep(0.5 - soft, 0.5 + soft, f)) / u_bands, 1.0);
}

void main() {
vec4 base = texture(u_textures[0], v_texCoord) * v_color * u_tint;

#ifdef MESH_NORMALS
    highp vec2 g=v_worldXYZ.xz;
    float laneX=-3.0+5.0*sin(g.y*.048+.35);
    float grain=sin(g.x*21.0+sin(g.y*13.0))*sin(g.y*17.0+g.x*5.0);
    float lane=exp(-pow(abs(g.x-laneX+grain*.16)/1.34,4.0));
    lane*=smoothstep(-22.,-17.,g.y)*(1.-smoothstep(43.,49.,g.y));
    float swath=sin(g.x*.27+sin(g.y*.21))*.3+sin(g.y*.33+g.x*.13)*.22;
    float detail=dot(base.rgb,vec3(.25,.6,.15));
    vec3 grass=mix(vec3(.168,.419,.109),vec3(.302,.55,.145),clamp(.48+swath+detail*.35,0.,1.));
    vec2 turf=g*vec2(3.1,2.65);
    vec2 grid=floor(turf);
    float tuft=fract(sin(dot(grid,vec2(57.3,113.1)))*5437.2);
    vec2 cell=fract(turf)-.5;
    float mark=(1.-smoothstep(.03,.21,abs(cell.x+.39*cell.y+(tuft-.5)*.55)))*(1.-smoothstep(.08,.44,abs(cell.y)));
    grass*=.74+clamp(detail*2.28,0.,.49)+mark*(tuft-.52)*.24;
    vec3 soil=mix(vec3(.34,.287,.159),vec3(.52,.433,.266),clamp(.35+detail+grain*.12,0.,1.));
    float shade=smoothstep(.48,1.12,length((g-vec2(-10.,-32.))/vec2(28.,22.))+swath*.115);
    vec3 shadeGrass=mix(vec3(.065,.141,.095),vec3(.110,.225,.126),clamp(.55+swath+detail*.3,0.,1.));
    base.rgb=mix(shadeGrass,grass,shade);
    base.rgb=mix(base.rgb,soil*mix(.56,1.,shade),lane);
#endif
float alpha = base.a;
if (u_alphaCutoff > 0.0) {
alpha = cutoutCoverage(base.a, u_alphaCutoff, fwidth(base.a));
if (alpha <= 0.0) discard;
alpha = min(alpha, 1.0);
}
#ifdef MESH_NORMALS
highp vec3 N = normalize(v_worldNormal);
if (!gl_FrontFacing) N = -N;
highp vec3 P = v_worldXYZ;
#else
highp vec3 N = vec3(0.0, 0.0, 1.0);
highp vec3 P = vec3(v_worldPos, 0.0);
#endif
float ao = mix(1.0, texture(u_occlusionMap, v_texCoord).r, u_occlusionStrength);
vec3 V = viewDirection(P);
float NdotV = max(dot(N, V), 1e-4);

float roughness = mix(0.7, 0.1, clamp(u_specSize, 0.0, 1.0));
float a = max(roughness * roughness, 1e-3);
vec3 F0 = vec3(0.04);
SurfaceExt ext = surfaceExtNone(N);

vec3 lit = vec3(0.0);
float glossLevel = 0.0;
vec3 glossTint = vec3(0.0);
for (int i = 0; i < 16; ++i) {
vec3 l = vec3(0.0), g = vec3(0.0), x = vec3(0.0);
shadeLight(u_lights[i].posDir, u_lights[i].color, u_lights[i].spot, u_lights[i].shadow,
u_lights[i].shadowMap, u_lights[i].falloff, N, V, P, a, F0, NdotV, 1.0, roughness, ext, l, g, x, true);
float level = max(l.r, max(l.g, l.b));
if (level > 1e-4) lit += l * (toonBand(level) / level);
float gl = max(g.r, max(g.g, g.b));
if (gl > glossLevel) { glossLevel = gl; glossTint = g / max(gl, 1e-4); }
}
float lightAmount = clamp(max(lit.r, max(lit.g, lit.b)), 0.0, 1.0);
g_probePos = P;
vec3 ambient = indirectIrradiance(N) * ao;

vec3 colour = base.rgb * (ambient + lit + u_shadeColor.rgb * (1.0 - lightAmount));
float spec = smoothstep(u_specThreshold - u_specSoftness, u_specThreshold + u_specSoftness, glossLevel);
colour = mix(colour, u_specColor.rgb * glossTint, spec * u_specColor.a * float(u_specThreshold < 1.0));
float rim = smoothstep(1.0 - u_rimWidth - u_rimSoftness, 1.0 - u_rimWidth + u_rimSoftness, 1.0 - NdotV);
colour += u_rimColor.rgb * rim * lightAmount * u_rimStrength;
fragColor = vec4(colour + u_emissive.rgb * texture(u_emissiveMap, v_texCoord).rgb, alpha);
#ifdef ES_GBUFFER
fragSurface = vec4(packNormal(normalize(N)), roughness, 0.75);
fragAlbedo = vec4(base.rgb, 1.0);
#endif
}
#pragma end

#pragma fragment wgsl
var<private> fragColor : vec4f;
var<private> fragSurface : vec4f;
var<private> fragAlbedo : vec4f;
#ifdef ES_GBUFFER
fn packNormal(n_in : vec3f) -> vec2f {
    var n = n_in;
    n /= (abs(n.x) + abs(n.y)) + abs(n.z);
    let sgn = vec2f(select(-1.0, 1.0, n.x >= 0.0), select(-1.0, 1.0, n.y >= 0.0));
    let e = select((1.0 - abs(n.yx)) * sgn, n.xy, n.z >= 0.0);
    return (e * 0.5) + 0.5;
}
#endif
fn toonBand(level : f32) -> f32 {
    let t = clamp(level, 0.0, 1.0) * mc.u_bands;
    let i = floor(t);
    let f = t - i;
    let soft = max(mc.u_bandSoftness, 1e-4);
    return min((i + smoothstep(0.5 - soft, 0.5 + soft, f)) / mc.u_bands, 1.0);
}
@diagnostic(off, derivative_uniformity)
fn es_main() {
    var base = (textureSample(t0, s0, es_v.v_texCoord) * es_v.v_color) * mc.u_tint;
#ifdef MESH_NORMALS
    var g = es_v.v_worldXYZ.xz;
    let laneX = -3.0 + (5.0 * sin((g.y * 0.048) + 0.35));
    let grain = sin((g.x * 21.0) + sin(g.y * 13.0)) * sin((g.y * 17.0) + (g.x * 5.0));
    var lane = exp(-pow(abs((g.x - laneX) + (grain * 0.16)) / 1.34, 4.0));
    lane *= smoothstep(-22.0, -17.0, g.y) * (1.0 - smoothstep(43.0, 49.0, g.y));
    let swath = (sin((g.x * 0.27) + sin(g.y * 0.21)) * 0.3) + (sin((g.y * 0.33) + (g.x * 0.13)) * 0.22);
    let detail = dot(base.rgb, vec3f(0.25, 0.6, 0.15));
    var grass = mix(vec3f(0.168, 0.419, 0.109), vec3f(0.302, 0.55, 0.145), clamp((0.48 + swath) + (detail * 0.35), 0.0, 1.0));
    let turf = g * vec2f(3.1, 2.65);
    let grid = floor(turf);
    let tuft = fract(sin(dot(grid, vec2f(57.3, 113.1))) * 5437.2);
    let cell = fract(turf) - 0.5;
    let mark = (1.0 - smoothstep(0.03, 0.21, abs((cell.x + (0.39 * cell.y)) + ((tuft - 0.5) * 0.55)))) * (1.0 - smoothstep(0.08, 0.44, abs(cell.y)));
    grass *= (0.74 + clamp(detail * 2.28, 0.0, 0.49)) + ((mark * (tuft - 0.52)) * 0.24);
    let soil = mix(vec3f(0.34, 0.287, 0.159), vec3f(0.52, 0.433, 0.266), clamp((0.35 + detail) + (grain * 0.12), 0.0, 1.0));
    let shade = smoothstep(0.48, 1.12, length((g - vec2f(-10.0, -32.0)) / vec2f(28.0, 22.0)) + (swath * 0.115));
    let shadeGrass = mix(vec3f(0.065, 0.141, 0.095), vec3f(0.110, 0.225, 0.126), clamp((0.55 + swath) + (detail * 0.3), 0.0, 1.0));
    { let es_t0 = mix(shadeGrass, grass, shade); base.r = es_t0.x; base.g = es_t0.y; base.b = es_t0.z; }
    { let es_t1 = mix(base.rgb, soil * mix(0.56, 1.0, shade), lane); base.r = es_t1.x; base.g = es_t1.y; base.b = es_t1.z; }
#endif
    var alpha = base.a;
    if (mc.u_alphaCutoff > 0.0) {
        alpha = cutoutCoverage(base.a, mc.u_alphaCutoff, fwidth(base.a));
        if (alpha <= 0.0) {
            discard;
        }
        alpha = min(alpha, 1.0);
    }
#ifdef MESH_NORMALS
    var N = normalize(es_v.v_worldNormal);
    if (!es_front) {
        N = -N;
    }
    let P = es_v.v_worldXYZ;
#else
    var N = vec3f(0.0, 0.0, 1.0);
    let P = vec3f(es_v.v_worldPos, 0.0);
#endif
    let ao = mix(1.0, textureSample(u_occlusionMap, u_occlusionMap_s, es_v.v_texCoord).r, mc.u_occlusionStrength);
    let V = viewDirection(P);
    let NdotV = max(dot(N, V), 1e-4);
    let roughness = mix(0.7, 0.1, clamp(mc.u_specSize, 0.0, 1.0));
    let a = max(roughness * roughness, 1e-3);
    let F0 = vec3f(0.04);
    let ext = surfaceExtNone(N);
    var lit = vec3f(0.0);
    var glossLevel = 0.0;
    var glossTint = vec3f(0.0);
    for (var i : i32 = 0; i < 16; i++) {
        var l = vec3f(0.0);
        var g = vec3f(0.0);
        var x = vec3f(0.0);
        { let es_t2 = shadeLight(lc.u_lights[i].posDir, lc.u_lights[i].color, lc.u_lights[i].spot, lc.u_lights[i].shadow, lc.u_lights[i].shadowMap, lc.u_lights[i].falloff, N, V, P, a, F0, NdotV, 1.0, roughness, ext, true); l += es_t2.lit; g += es_t2.gloss; x += es_t2.extra; }
        let level = max(l.r, max(l.g, l.b));
        if (level > 1e-4) {
            lit += l * (toonBand(level) / level);
        }
        let gl = max(g.r, max(g.g, g.b));
        if (gl > glossLevel) {
            glossLevel = gl;
            glossTint = g / max(gl, 1e-4);
        }
    }
    let lightAmount = clamp(max(lit.r, max(lit.g, lit.b)), 0.0, 1.0);
    g_probePos = P;
    let ambient = indirectIrradiance(N) * ao;
    var colour = base.rgb * ((ambient + lit) + (mc.u_shadeColor.rgb * (1.0 - lightAmount)));
    let spec = smoothstep(mc.u_specThreshold - mc.u_specSoftness, mc.u_specThreshold + mc.u_specSoftness, glossLevel);
    colour = mix(colour, mc.u_specColor.rgb * glossTint, (spec * mc.u_specColor.a) * f32(mc.u_specThreshold < 1.0));
    let rim = smoothstep((1.0 - mc.u_rimWidth) - mc.u_rimSoftness, (1.0 - mc.u_rimWidth) + mc.u_rimSoftness, 1.0 - NdotV);
    colour += ((mc.u_rimColor.rgb * rim) * lightAmount) * mc.u_rimStrength;
    fragColor = vec4f(colour + (mc.u_emissive.rgb * textureSample(u_emissiveMap, u_emissiveMap_s, es_v.v_texCoord).rgb), alpha);
#ifdef ES_GBUFFER
    fragSurface = vec4f(packNormal(normalize(N)), roughness, 0.75);
    fragAlbedo = vec4f(base.rgb, 1.0);
#endif
}
var<private> es_v : VSOut;
var<private> es_front : bool;
#if !defined(ES_GBUFFER)
@fragment fn fs_main(es_in : VSOut, @builtin(front_facing) es_ff : bool) -> @location(0) vec4f {
    es_v = es_in; es_front = es_ff;
#ifdef MESH_TANGENTS
    g_worldTangent = es_in.v_worldTangent;
#endif
#ifdef MESH_LIGHTMAP
    g_lightmap = es_in.v_lightmap;
#endif
    g_probeSlot = es_in.v_probeSlot;
    es_main();
    return fragColor;
}
#endif
#if defined(ES_GBUFFER)
struct es_FragOut {
    @location(0) fragColor : vec4f,
    @location(1) fragSurface : vec4f,
    @location(2) fragAlbedo : vec4f,
};
@fragment fn fs_main(es_in : VSOut, @builtin(front_facing) es_ff : bool) -> es_FragOut {
    es_v = es_in; es_front = es_ff;
#ifdef MESH_TANGENTS
    g_worldTangent = es_in.v_worldTangent;
#endif
#ifdef MESH_LIGHTMAP
    g_lightmap = es_in.v_lightmap;
#endif
    g_probeSlot = es_in.v_probeSlot;
    es_main();
    return es_FragOut(fragColor, fragSurface, fragAlbedo);
}
#endif
#pragma end
