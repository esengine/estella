#pragma shader "Weathered oak bark"
#pragma version 300 es
#pragma domain Unlit
#pragma fragment
precision highp float;
in vec4 v_color;
in vec2 v_texCoord;
out vec4 fragColor;
float hash(vec2 p){return fract(sin(dot(p,vec2(27.451,61.317)))*43758.5453);}
float noise(vec2 p){
    vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);
    return mix(mix(hash(i),hash(i+vec2(1,0)),f.x),mix(hash(i+vec2(0,1)),hash(i+1.),f.x),f.y);
}
void main(){
    vec2 p=v_texCoord;
    float warp=noise(vec2(p.x*7.,p.y*1.8));
    float furrow=noise(vec2(p.x*42.+warp*2.2,p.y*2.8));
    float fine=noise(vec2(p.x*127.+warp*4.7,p.y*9.));
    float ridge=smoothstep(.26,.66,furrow)*.35 + fine*.08;
    vec3 stone=mix(vec3(.029,.048,.059),vec3(.182,.160,.122),clamp(v_color.r*.79+ridge-.12,0.,1.));
    stone=mix(stone,vec3(.105,.152,.075),v_color.g*.58);
    fragColor=vec4(stone,1.);
}
#pragma end

#pragma fragment wgsl
var<private> fragColor : vec4f;
fn hash(p : vec2f) -> f32 {
    return fract(sin(dot(p, vec2f(27.451, 61.317))) * 43758.5453);
}
fn noise(p : vec2f) -> f32 {
    let i = floor(p);
    var f = fract(p);
    f = (f * f) * (3.0 - (2.0 * f));
    return mix(mix(hash(i), hash(i + vec2f(1, 0)), f.x), mix(hash(i + vec2f(0, 1)), hash(i + 1.0), f.x), f.y);
}
fn es_main() {
    let p = es_v.v_texCoord;
    let warp = noise(vec2f(p.x * 7.0, p.y * 1.8));
    let furrow = noise(vec2f((p.x * 42.0) + (warp * 2.2), p.y * 2.8));
    let fine = noise(vec2f((p.x * 127.0) + (warp * 4.7), p.y * 9.0));
    let ridge = (smoothstep(0.26, 0.66, furrow) * 0.35) + (fine * 0.08);
    var stone = mix(vec3f(0.029, 0.048, 0.059), vec3f(0.182, 0.160, 0.122), clamp(((es_v.v_color.r * 0.79) + ridge) - 0.12, 0.0, 1.0));
    stone = mix(stone, vec3f(0.105, 0.152, 0.075), es_v.v_color.g * 0.58);
    fragColor = vec4f(stone, 1.0);
}
var<private> es_v : VSOut;
@fragment fn fs_main(es_in : VSOut) -> @location(0) vec4f {
    es_v = es_in;
    es_main();
    return fragColor;
}
#pragma end
