#pragma shader "Oak foliage"
#pragma version 300 es
#pragma domain Unlit
#pragma param u_alphaCutoff float default(0.46) range(0,1)
#pragma coverage u_alphaCutoff
#pragma fragment
precision highp float;
in vec4 v_color;
in vec2 v_texCoord;
uniform sampler2D u_textures[1];
out vec4 fragColor;
void main() {
    vec4 tuft = texture(u_textures[0], v_texCoord);
    if (tuft.a < u_alphaCutoff) discard;
    float brush = dot(tuft.rgb,vec3(.24,.66,.1));
    float value = clamp(v_color.r + (brush-.31)*.37,0.,1.);
    value += .088*smoothstep(.12,.40,value)*(1.-smoothstep(.75,.96,value));
    vec3 shadow = vec3(.011,.055,.042);
    vec3 leaf = mix(shadow,vec3(.066,.236,.104),smoothstep(.04,.53,value));
    leaf = mix(leaf,vec3(.35,.59,.189),smoothstep(.37,.81,value));
    leaf = mix(leaf,vec3(.55,.76,.273),smoothstep(.73,1.,value));
    leaf *= .88 + brush*.39;
    leaf = mix(leaf,vec3(.11,.28,.266),v_color.g*.62);
    fragColor = vec4(leaf,1.);
}
#pragma end

#pragma fragment wgsl
var<private> fragColor : vec4f;
@diagnostic(off, derivative_uniformity)
fn es_main() {
    let tuft = textureSample(t0, s0, es_v.v_texCoord);
    if (tuft.a < mc.u_alphaCutoff) {
        discard;
    }
    let brush = dot(tuft.rgb, vec3f(0.24, 0.66, 0.1));
    var value = clamp(es_v.v_color.r + ((brush - 0.31) * 0.37), 0.0, 1.0);
    value += (0.088 * smoothstep(0.12, 0.40, value)) * (1.0 - smoothstep(0.75, 0.96, value));
    let shadow = vec3f(0.011, 0.055, 0.042);
    var leaf = mix(shadow, vec3f(0.066, 0.236, 0.104), smoothstep(0.04, 0.53, value));
    leaf = mix(leaf, vec3f(0.35, 0.59, 0.189), smoothstep(0.37, 0.81, value));
    leaf = mix(leaf, vec3f(0.55, 0.76, 0.273), smoothstep(0.73, 1.0, value));
    leaf *= 0.88 + (brush * 0.39);
    leaf = mix(leaf, vec3f(0.11, 0.28, 0.266), es_v.v_color.g * 0.62);
    fragColor = vec4f(leaf, 1.0);
}
var<private> es_v : VSOut;
@fragment fn fs_main(es_in : VSOut) -> @location(0) vec4f {
    es_v = es_in;
    es_main();
    return fragColor;
}
#pragma end
