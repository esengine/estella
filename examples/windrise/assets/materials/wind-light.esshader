#pragma shader "Anemo beacon"
#pragma version 300 es
#pragma domain Unlit
#pragma fragment
precision highp float;
in vec2 v_texCoord;
out vec4 fragColor;
void main(){
    float x=v_texCoord.x*2.-1.;
    float core=exp(-38.*x*x);
    float halo=exp(-4.9*x*x);
    float fade=(1.-smoothstep(.63,1.,v_texCoord.y))*smoothstep(0.,.028,v_texCoord.y);
    fragColor=vec4(mix(vec3(.045,.13,1.7),vec3(.44,.76,2.8),core),(.29*core+.16*halo)*fade);
}
#pragma end

#pragma fragment wgsl
var<private> fragColor : vec4f;
fn es_main() {
    let x = (es_v.v_texCoord.x * 2.0) - 1.0;
    let core = exp((-38.0 * x) * x);
    let halo = exp((-4.9 * x) * x);
    let fade = (1.0 - smoothstep(0.63, 1.0, es_v.v_texCoord.y)) * smoothstep(0.0, 0.028, es_v.v_texCoord.y);
    fragColor = vec4f(mix(vec3f(0.045, 0.13, 1.7), vec3f(0.44, 0.76, 2.8), core), ((0.29 * core) + (0.16 * halo)) * fade);
}
var<private> es_v : VSOut;
@fragment fn fs_main(es_in : VSOut) -> @location(0) vec4f {
    es_v = es_in;
    es_main();
    return fragColor;
}
#pragma end
