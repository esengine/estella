{
  "formatVersion": "1",
  "name": "风起地 · Windrise Study",
  "description": "An explorable anime landscape study with a 3D traveler, sunlit meadows, water and a native 2D HUD.",
  "tag": "3D",
  "version": "0.1.0",
  "defaultScene": "assets/scenes/main.esscene",
  "designResolution": { "width": 1600, "height": 900 },
  "spineVersion": "none",
  "scripts": { "main": "src/main.ts" },
  "assetExclude": ["tools", "references", "source"],
  "features": {
    "rendering": {
      "colorSpace": "linear",
      "outputTransform": "neutral",
      "quality": {
        "mode": "auto",
        "targetFps": 60,
        "dynamicResolution": true,
        "asyncShaderCompile": true,
        "prewarmShaders": true,
        "prewarmTimeoutMs": 12000,
        "profiles": {
          "low": { "textureStreaming": false },
          "medium": { "antialiasing": "msaa", "msaaSamples": 1, "depthPrepass": false, "stillSky": false, "textureStreaming": false },
          "high": { "msaaSamples": 2, "depthPrepass": false }
        }
      }
    }
  }
}
