#pragma shader "RenderClock"
#pragma version 300 es
#pragma domain Unlit

#pragma fragment
precision highp float;
out vec4 fragColor;
void main() {
    float phase = fract(u_time.x);
    fragColor = vec4(phase, 1.0 - phase, 0.0, 1.0);
}
#pragma end

#pragma fragment wgsl
@fragment fn fs_main(v: VSOut) -> @location(0) vec4f {
    let phase = fract(tc.u_time.x);
    return vec4f(phase, 1.0 - phase, 0.0, 1.0);
}
#pragma end
