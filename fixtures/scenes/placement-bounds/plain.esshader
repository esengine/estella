#pragma shader "PlacementBoundsPlain"
#pragma version 300 es
#pragma domain Unlit

#pragma fragment
precision highp float;
out vec4 fragColor;
void main() {
    fragColor = vec4(0.0, 1.0, 0.0, 1.0);
}
#pragma end

#pragma fragment wgsl
@fragment fn fs_main(v: VSOut) -> @location(0) vec4f {
    return vec4f(0.0, 1.0, 0.0, 1.0);
}
#pragma end
