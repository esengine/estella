#pragma shader "UIGlowTest"
#pragma version 300 es
#pragma domain Unlit
#pragma param u_glow color default(1,1,1,1)

#pragma fragment
precision highp float;

in vec4 v_color;
in vec2 v_texCoord;

uniform sampler2D u_textures[8];

out vec4 fragColor;

void main() {
    fragColor = u_glow;
}
#pragma end

#pragma fragment wgsl
@fragment fn fs_main(v : VSOut) -> @location(0) vec4f {
    return mc.u_glow;
}
#pragma end
