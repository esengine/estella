#pragma shader "UIEffectShift"
#pragma version 300 es
#pragma domain PostProcess
#pragma param u_shift float default(0) range(-1,1)

#pragma fragment
precision highp float;

in vec2 v_texCoord;
uniform sampler2D u_texture;
out vec4 fragColor;

void main() {
    vec2 uv = v_texCoord - vec2(u_shift, 0.0);
    vec4 layer = texture(u_texture, uv);
    fragColor = (uv.x < 0.0 || uv.x > 1.0) ? vec4(0.0) : layer;
}
#pragma end

#pragma fragment wgsl
@fragment fn fs_main(v : VSOut) -> @location(0) vec4f {
    let uv = v.v_texCoord - vec2f(mc.u_shift, 0.0);
    let layer = textureSampleLevel(t0, s0, uv, 0.0);
    if (uv.x < 0.0 || uv.x > 1.0) { return vec4f(0.0); }
    return layer;
}
#pragma end
