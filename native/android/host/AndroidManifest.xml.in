<?xml version="1.0" encoding="utf-8"?>
<!--
  The APK's manifest, as a template. Packaging substitutes the app's identity from
  the exported project's app.config.json: an installed app has one identity, one
  version and one orientation, and none of them can be decided here.

  Everything left alone is the host itself: a NativeActivity (no Java, so hasCode
  is false), Vulkan 1.0.3 as a hard requirement, and the config changes the host
  handles rather than being restarted for.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="@APP_ID@"
          android:versionCode="@VERSION_CODE@"
          android:versionName="@VERSION_NAME@">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />
    <application android:label="@APP_NAME@" android:hasCode="false" android:extractNativeLibs="true">
        <activity android:name="android.app.NativeActivity"
                  android:label="@APP_NAME@"
                  android:screenOrientation="@SCREEN_ORIENTATION@"
                  android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density"
                  android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="estella_js_host" />
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
