{
  "name": "esengine",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Estella SDK - A fast 2D/3D game engine for Web, WeChat MiniGames and native platforms",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.lean.js",
    "./dist/wasm.js",
    "./dist/index.wechat.js",
    "./dist/index.wechat.lean.js",
    "./dist/index.minigame.js",
    "./dist/index.node.js",
    "./dist/index.native.js",
    "./dist/dragonbones/index.js",
    "./dist/spine/index.js",
    "./dist/tilemap/index.js",
    "./dist/logic/index.js",
    "./dist/ai/index.js",
    "./dist/net/replication/index.js",
    "./dist/gameplay/index.js",
    "./dist/physics/index.js",
    "./dist/physics3d/index.js",
    "./dist/douyin/index.js",
    "./dist/kuaishou/index.js",
    "./dist/bilibili/index.js",
    "./dist/quickgame/index.js",
    "./dist/index.wechat.cjs.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wasm": {
      "import": "./dist/wasm.js",
      "types": "./dist/wasm.d.ts"
    },
    "./wechat": {
      "import": "./dist/index.wechat.js"
    },
    "./minigame": {
      "import": "./dist/index.minigame.js",
      "types": "./dist/index.minigame.d.ts"
    },
    "./node": {
      "import": "./dist/index.node.js",
      "types": "./dist/index.node.d.ts"
    },
    "./native": {
      "import": "./dist/index.native.js",
      "types": "./dist/index.native.d.ts"
    },
    "./dragonbones": {
      "import": "./dist/dragonbones/index.js",
      "types": "./dist/dragonbones/index.d.ts"
    },
    "./spine": {
      "import": "./dist/spine/index.js",
      "types": "./dist/spine/index.d.ts"
    },
    "./tilemap": {
      "import": "./dist/tilemap/index.js",
      "types": "./dist/tilemap/index.d.ts"
    },
    "./logic": {
      "import": "./dist/logic/index.js",
      "types": "./dist/logic/index.d.ts"
    },
    "./ai": {
      "import": "./dist/ai/index.js",
      "types": "./dist/ai/index.d.ts"
    },
    "./replication": {
      "import": "./dist/net/replication/index.js",
      "types": "./dist/net/replication/index.d.ts"
    },
    "./gameplay": {
      "import": "./dist/gameplay/index.js",
      "types": "./dist/gameplay/index.d.ts"
    },
    "./physics": {
      "import": "./dist/physics/index.js",
      "types": "./dist/physics/index.d.ts"
    },
    "./physics3d": {
      "import": "./dist/physics3d/index.js",
      "types": "./dist/physics3d/index.d.ts"
    },
    "./douyin": {
      "import": "./dist/douyin/index.js",
      "types": "./dist/douyin/index.d.ts"
    },
    "./kuaishou": {
      "import": "./dist/kuaishou/index.js",
      "types": "./dist/kuaishou/index.d.ts"
    },
    "./bilibili": {
      "import": "./dist/bilibili/index.js",
      "types": "./dist/bilibili/index.d.ts"
    },
    "./quickgame": {
      "import": "./dist/quickgame/index.js",
      "types": "./dist/quickgame/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && rolldown -c && rollup -c",
    "watch": "rolldown -c -w",
    "clean": "rimraf dist",
    "api:check": "node ../tools/api-surface.mjs --check",
    "api:update": "node ../tools/api-surface.mjs --update",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "bench": "vitest bench",
    "bench:watch": "vitest bench --watch"
  },
  "keywords": [
    "game-engine",
    "ecs",
    "webgl",
    "wechat-minigame",
    "typescript",
    "modular"
  ],
  "author": "Estella Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.0",
    "fast-check": "^4.9.0",
    "happy-dom": "^15.11.0",
    "minigame-api-typings": "^3.8.16",
    "rimraf": "^5.0.5",
    "rolldown": "1.2.1",
    "rollup": "^4.9.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0",
    "ws": "^8.21.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/esengine/esengine.git"
  }
}
