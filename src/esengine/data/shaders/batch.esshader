#pragma shader "Batch"
#pragma version 300 es

// Compile-time variant: lit by the scene's 2D lights (Sprite.lit). Compiled as a
// Lit-domain shader, so applyLighting2D + LightConstants are injected.
#pragma feature LIT

// Compile-time variant: discard fragments the sprite draws as (near-)transparent.
// Selected for a STENCIL MASK draw, which runs this shader with color writes off:
// without the discard every transparent corner of the quad still writes stencil,
// so a circular mask sprite would clip a rectangle. Off for ordinary sprites, so
// they keep an unconditional (early-Z friendly) fragment path.
#pragma feature ALPHA_CLIP

// The vertex tint arrives straight; multiply coverage after color conversion.
#pragma feature PREMULTIPLIED_COLOR
// What a draw blended as Multiply or Screen is drawn with: those blends add the source's colour as it is, so a straight-alpha
// texel that is clear but white would light or whiten what is behind it. Premultiplied, a clear texel is nothing.
#pragma feature PREMULTIPLY_OUTPUT

// Compile-time variant: one resident shape drawn once per instance (Draw.triangles on a
// buffer, what a Graphics draws through). The vertices are the shape's own, kept on the
// GPU; each instance brings a 2D affine and a tint, applied here, so a copy costs the
// CPU one 28-byte record instead of a transformed copy of every vertex.
#pragma feature INSTANCED

#pragma vertex
layout(location = 0) in vec3 a_position;
layout(location = 1) in vec4 a_color;
layout(location = 2) in vec2 a_texCoord;
layout(location = 3) in float a_texIndex;
layout(location = 4) in float a_sdfBias;
#ifdef INSTANCED
// x' = a_xform.x * x + a_xform.z * y + a_offset.x, y' = a_xform.y * x + a_xform.w * y + a_offset.y
layout(location = 5) in vec4 a_xform;
layout(location = 6) in vec2 a_offset;
layout(location = 7) in vec4 a_tint;
#endif

out vec4 v_color;
out vec2 v_texCoord;
flat out int v_texIndex;
#ifdef LIT
out highp vec2 v_worldPos;
flat out highp float v_lightLayer;
#else
out float v_sdfBias;
#endif

void main() {
#ifdef INSTANCED
    vec3 position = vec3(a_xform.xy * a_position.x + a_xform.zw * a_position.y + a_offset, a_position.z);
    v_color = a_color * a_tint;
#else
    vec3 position = a_position;
    v_color = a_color;
#endif
    gl_Position = u_projection * vec4(position, 1.0);
    v_texCoord = a_texCoord;
    v_texIndex = int(a_texIndex);
#ifdef LIT
    v_worldPos = position.xy;
    v_lightLayer = a_sdfBias;
#else
    v_sdfBias = a_sdfBias;
#endif
}
#pragma end

#pragma fragment
// highp: the SDF text branch needs precise distance + fwidth derivatives, and
// sprite sampling is unaffected by the wider range.
precision highp float;

in vec4 v_color;
in vec2 v_texCoord;
flat in int v_texIndex;
#ifdef LIT
in highp vec2 v_worldPos;
flat in highp float v_lightLayer;
#else
in float v_sdfBias;
#endif

// Up to 8 textures bound per multi-texture batch. GLSL ES 3.00 forbids indexing a
// sampler array with a non-uniform expression, so the slot is selected by a constant
// branch chain (the standard WebGL2 multi-texture batching technique).
uniform sampler2D u_textures[8];

// A soft-edged UI mask (UIMask.softness): its box in framebuffer pixels and how far in from each edge (left, bottom, right, top) what it
// holds fades in. The zero block, all zeros, is no soft clip.
layout(std140) uniform ClipConstants {
    highp vec4 u_clipRect;
    highp vec4 u_clipEdge;
};

float softClip() {
    if (u_clipEdge.x + u_clipEdge.y + u_clipEdge.z + u_clipEdge.w <= 0.0) return 1.0;
    highp vec2 p = gl_FragCoord.xy;
    highp vec4 inside = vec4(p - u_clipRect.xy, u_clipRect.zw - p);
    highp vec4 fade = clamp(inside / max(u_clipEdge, vec4(1e-4)), 0.0, 1.0);
    fade = mix(vec4(1.0), fade, step(vec4(1e-4), u_clipEdge));
    return fade.x * fade.y * fade.z * fade.w;
}

out vec4 fragColor;

void main() {
    // Dithered (BATCH_DITHER_BIT): one half of a checkerboard, the half BATCH_DITHER_PHASE_BIT names, at full colour —
    // a handle behind geometry, readable over any background where a faded one is lost.
    if ((v_texIndex & 256) != 0 && ((int(gl_FragCoord.x) + int(gl_FragCoord.y)) & 1) != ((v_texIndex >> 9) & 1)) discard;
    int slot = v_texIndex & 7;
    vec4 texColor;
    if (slot == 0) texColor = texture(u_textures[0], v_texCoord);
    else if (slot == 1) texColor = texture(u_textures[1], v_texCoord);
    else if (slot == 2) texColor = texture(u_textures[2], v_texCoord);
    else if (slot == 3) texColor = texture(u_textures[3], v_texCoord);
    else if (slot == 4) texColor = texture(u_textures[4], v_texCoord);
    else if (slot == 5) texColor = texture(u_textures[5], v_texCoord);
    else if (slot == 6) texColor = texture(u_textures[6], v_texCoord);
    else texColor = texture(u_textures[7], v_texCoord);
#ifdef ES_LINEAR
    // Vertex colors are authored sRGB; the sampled texel is already linear
    // (sRGB texture formats decode in hardware). Alpha is coverage — never encoded.
    vec4 tint = vec4(srgbToLinear(v_color.rgb), v_color.a);
#else
    vec4 tint = v_color;
#endif
#ifdef PREMULTIPLIED_COLOR
    tint.rgb *= tint.a;
#endif
#ifdef LIT
    vec4 base = texColor * tint;
    fragColor = vec4(applyLighting2DLayer(base.rgb, vec3(0.0, 0.0, 1.0), v_worldPos, v_lightLayer), base.a);
#else
    int mode = (v_texIndex >> 3) & 31;
    vec2 duvx = dFdx(v_texCoord);
    vec2 duvy = dFdy(v_texCoord);
    float distWidth = fwidth(texColor.a);
    if (mode == 1) {
        ivec2 page;
        if (slot == 0) page = textureSize(u_textures[0], 0);
        else if (slot == 1) page = textureSize(u_textures[1], 0);
        else if (slot == 2) page = textureSize(u_textures[2], 0);
        else if (slot == 3) page = textureSize(u_textures[3], 0);
        else if (slot == 4) page = textureSize(u_textures[4], 0);
        else if (slot == 5) page = textureSize(u_textures[5], 0);
        else if (slot == 6) page = textureSize(u_textures[6], 0);
        else page = textureSize(u_textures[7], 0);
        vec2 acrossX = duvx * vec2(page);
        vec2 acrossY = duvy * vec2(page);
        float texelsPerPixel = sqrt(0.5 * (dot(acrossX, acrossX) + dot(acrossY, acrossY)));
        float dist = texColor.a;
        float pixelsPerUnit = min(1.0 / max(distWidth, 1e-6), texColor.r * 255.0 / max(texelsPerPixel, 1e-6));
        float screenPxDist = (dist - 0.5 + v_sdfBias) * pixelsPerUnit;
        float coverage = v_sdfBias < -1.0 ? dist : clamp(screenPxDist + 0.5, 0.0, 1.0);
        fragColor = vec4(tint.rgb, tint.a * coverage);
    } else if (mode == 2) {
        fragColor = vec4(tint.rgb, tint.a * texColor.a);
    } else if (mode == 3) {
        fragColor = vec4(tint.rgb, tint.a * texColor.r * texColor.a);
    } else {
  #ifdef ALPHA_CLIP
        if (texColor.a < 0.5) discard;
  #endif
        fragColor = texColor * tint;
    }
#endif
#ifdef PREMULTIPLIED_COLOR
    fragColor *= softClip();
#else
    fragColor.a *= softClip();
#endif
#ifdef ES_LINEAR
  #ifdef DISPLAY_OUTPUT
    #ifdef PREMULTIPLIED_COLOR
    fragColor.rgb = linearToSrgb(fragColor.rgb / max(fragColor.a, 1e-5)) * fragColor.a;
    #else
    fragColor.rgb = linearToSrgb(fragColor.rgb);
    #endif
  #endif
#endif
#ifdef PREMULTIPLY_OUTPUT
    fragColor.rgb *= fragColor.a;
#endif
}
#pragma end

#pragma vertex wgsl
struct VSIn {
    @location(0) a_position : vec3f,
    @location(1) a_color : vec4f,
    @location(2) a_texCoord : vec2f,
    @location(3) a_texIndex : f32,
    @location(4) a_sdfBias : f32,
#ifdef INSTANCED
    @location(5) a_xform : vec4f,
    @location(6) a_offset : vec2f,
    @location(7) a_tint : vec4f,
#endif
};
struct VSOut {
    @builtin(position) pos : vec4f,
    @location(0) v_color : vec4f,
    @location(1) v_texCoord : vec2f,
    @location(2) v_texIndex : f32,
#ifdef LIT
    @location(3) v_worldPos : vec2f,
    @location(5) @interpolate(flat) v_lightLayer : f32,
#else
    @location(4) v_sdfBias : f32,
#endif
};

@vertex fn vs_main(v : VSIn) -> VSOut {
    var out : VSOut;
#ifdef INSTANCED
    let position = vec3f(v.a_xform.xy * v.a_position.x + v.a_xform.zw * v.a_position.y + v.a_offset, v.a_position.z);
    out.v_color = v.a_color * v.a_tint;
#else
    let position = v.a_position;
    out.v_color = v.a_color;
#endif
    out.pos = frame.projection * vec4f(position, 1.0);
    out.v_texCoord = v.a_texCoord;
    out.v_texIndex = v.a_texIndex;
#ifdef LIT
    out.v_worldPos = position.xy;
    out.v_lightLayer = v.a_sdfBias;
#else
    out.v_sdfBias = v.a_sdfBias;
#endif
    // Clip y turned over: a target's rows land bottom-up, as GL lays them (see WebGPUDevice::ensurePipeline).
    out.pos.y = -out.pos.y;
    return out;
}
#pragma end

#pragma fragment wgsl
@group(1) @binding(0) var t0 : texture_2d<f32>;
@group(1) @binding(1) var t1 : texture_2d<f32>;
@group(1) @binding(2) var t2 : texture_2d<f32>;
@group(1) @binding(3) var t3 : texture_2d<f32>;
@group(1) @binding(4) var t4 : texture_2d<f32>;
@group(1) @binding(5) var t5 : texture_2d<f32>;
@group(1) @binding(6) var t6 : texture_2d<f32>;
@group(1) @binding(7) var t7 : texture_2d<f32>;
@group(1) @binding(8) var s0 : sampler;
@group(1) @binding(9) var s1 : sampler;
@group(1) @binding(10) var s2 : sampler;
@group(1) @binding(11) var s3 : sampler;
@group(1) @binding(12) var s4 : sampler;
@group(1) @binding(13) var s5 : sampler;
@group(1) @binding(14) var s6 : sampler;
@group(1) @binding(15) var s7 : sampler;

struct ClipConstants { u_clipRect : vec4f, u_clipEdge : vec4f };
@group(0) @binding(6) var<uniform> es_clip : ClipConstants;

fn softClip(p : vec2f) -> f32 {
    let edge = es_clip.u_clipEdge;
    if (edge.x + edge.y + edge.z + edge.w <= 0.0) { return 1.0; }
    let inside = vec4f(p - es_clip.u_clipRect.xy, es_clip.u_clipRect.zw - p);
    let fade = mix(vec4f(1.0), clamp(inside / max(edge, vec4f(1e-4)), vec4f(0.0), vec4f(1.0)), step(vec4f(1e-4), edge));
    return fade.x * fade.y * fade.z * fade.w;
}

struct VSOut {
    @builtin(position) pos : vec4f,
    @location(0) v_color : vec4f,
    @location(1) v_texCoord : vec2f,
    @location(2) v_texIndex : f32,
#ifdef LIT
    @location(3) v_worldPos : vec2f,
    @location(5) @interpolate(flat) v_lightLayer : f32,
#else
    @location(4) v_sdfBias : f32,
#endif
};

@fragment fn fs_main(v : VSOut) -> @location(0) vec4f {
    let idx = i32(v.v_texIndex + 0.5);
    // See the GLSL twin: a discard demotes the invocation, so the derivatives below stay in uniform control flow.
    if ((idx & 256) != 0 && ((i32(v.pos.x) + i32(v.pos.y)) & 1) != ((idx >> 9u) & 1)) { discard; }
    let slot = idx & 7;
    let duvx = dpdx(v.v_texCoord);
    let duvy = dpdy(v.v_texCoord);
    var texColor : vec4f;
    if (slot == 0) { texColor = textureSampleGrad(t0, s0, v.v_texCoord, duvx, duvy); }
    else if (slot == 1) { texColor = textureSampleGrad(t1, s1, v.v_texCoord, duvx, duvy); }
    else if (slot == 2) { texColor = textureSampleGrad(t2, s2, v.v_texCoord, duvx, duvy); }
    else if (slot == 3) { texColor = textureSampleGrad(t3, s3, v.v_texCoord, duvx, duvy); }
    else if (slot == 4) { texColor = textureSampleGrad(t4, s4, v.v_texCoord, duvx, duvy); }
    else if (slot == 5) { texColor = textureSampleGrad(t5, s5, v.v_texCoord, duvx, duvy); }
    else if (slot == 6) { texColor = textureSampleGrad(t6, s6, v.v_texCoord, duvx, duvy); }
    else { texColor = textureSampleGrad(t7, s7, v.v_texCoord, duvx, duvy); }
#ifdef ES_LINEAR
    var tint = vec4f(srgbToLinear(v.v_color.rgb), v.v_color.a);
#else
    var tint = v.v_color;
#endif
#ifdef PREMULTIPLIED_COLOR
    tint = vec4f(tint.rgb * tint.a, tint.a);
#endif
#ifdef LIT
    let base = texColor * tint;
    var shown = vec4f(applyLighting2DLayer(base.rgb, vec3f(0.0, 0.0, 1.0), v.v_worldPos, v.v_lightLayer), base.a);
#else
    let mode = (idx >> 3u) & 31;
    let distWidth = fwidth(texColor.a);
    var shown : vec4f;
    if (mode == 1) {
        var page : vec2u;
        if (slot == 0) { page = textureDimensions(t0); }
        else if (slot == 1) { page = textureDimensions(t1); }
        else if (slot == 2) { page = textureDimensions(t2); }
        else if (slot == 3) { page = textureDimensions(t3); }
        else if (slot == 4) { page = textureDimensions(t4); }
        else if (slot == 5) { page = textureDimensions(t5); }
        else if (slot == 6) { page = textureDimensions(t6); }
        else { page = textureDimensions(t7); }
        let acrossX = duvx * vec2f(page);
        let acrossY = duvy * vec2f(page);
        let texelsPerPixel = sqrt(0.5 * (dot(acrossX, acrossX) + dot(acrossY, acrossY)));
        let dist = texColor.a;
        let pixelsPerUnit = min(1.0 / max(distWidth, 1e-6), texColor.r * 255.0 / max(texelsPerPixel, 1e-6));
        let screenPxDist = (dist - 0.5 + v.v_sdfBias) * pixelsPerUnit;
        let coverage = select(clamp(screenPxDist + 0.5, 0.0, 1.0), dist, v.v_sdfBias < -1.0);
        shown = vec4f(tint.rgb, tint.a * coverage);
    } else if (mode == 2) {
        shown = vec4f(tint.rgb, tint.a * texColor.a);
    } else if (mode == 3) {
        shown = vec4f(tint.rgb, tint.a * texColor.r * texColor.a);
    } else {
  #ifdef ALPHA_CLIP
        if (texColor.a < 0.5) { discard; }
  #endif
        shown = texColor * tint;
    }
#endif
    // The framebuffer y the scissor counts (the vertex stage turned clip y, so this position runs as GL's does).
#ifdef PREMULTIPLIED_COLOR
    shown = shown * softClip(v.pos.xy);
#else
    shown = vec4f(shown.rgb, shown.a * softClip(v.pos.xy));
#endif
#ifdef ES_LINEAR
  #ifdef DISPLAY_OUTPUT
    #ifdef PREMULTIPLIED_COLOR
    var result = vec4f(linearToSrgb(shown.rgb / max(shown.a, 1e-5)) * shown.a, shown.a);
    #else
    var result = vec4f(linearToSrgb(shown.rgb), shown.a);
    #endif
  #else
    var result = shown;
  #endif
#else
    var result = shown;
#endif
#ifdef PREMULTIPLY_OUTPUT
    result = vec4f(result.rgb * result.a, result.a);
#endif
    return result;
}
#pragma end
